# Local dev: SQLite file. Deploy: Postgres connection string (Neon / Vercel Postgres)
DATABASE_URL="file:./dev.db"

NEXTAUTH_SECRET="replace-with-output-of: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Stripe (test mode keys — get these from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Shared invite code required to self-register as Vendor/Tailor staff.
# In a real production setup, admin-managed invites would replace this.
STAFF_INVITE_CODE="replace-with-a-real-shared-secret"

# Supabase (if used)
# Set these in Vercel / your environment provider — do NOT commit secrets.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# MongoDB Atlas
# Example key name: MONGODB_URI
# Example value format (do NOT commit actual credentials):
# mongodb+srv://<db_user>:<db_password>@cluster0.abcdef.mongodb.net/myDatabase?retryWrites=true&w=majority&appName=YourAppName
# If you want to test locally, create a `.env.local` that contains the real URI.
MONGODB_URI=""

# Optional: other runtime keys
NEXT_PUBLIC_APP_NAME="FUJRS"
