# Local dev: SQLite file. Deploy: Postgres connection string (Neon / Vercel Postgres)
DATABASE_URL="file:./dev.db"

NEXTAUTH_SECRET="replace-with-output-of: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Stripe (test mode keys — get these from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Shared invite code required to self-register as Vendor/Tailor staff.
# In a real production setup, admin-managed invites would replace this.
STAFF_INVITE_CODE="replace-with-a-real-shared-secret"
