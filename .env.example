# This build is UI-only — there is no backend, database, or payment provider
# wired up, and no environment variables are required to run it.
#
# Everything (cart, wishlist, measurements, orders, accounts) is stored in the
# browser's localStorage. The dashboards render sample data from
# src/lib/auth/demoData.ts.
#
# Sign in with any password using one of the demo accounts listed on /login:
#   user@gmail.com        Customer
#   admin@gmail.com       Admin
#   vendor@gmail.com      Vendor
#   tailor@gmail.com      Tailor
#   superadmin@gmail.com  Super Admin

NEXT_PUBLIC_APP_NAME="FUJRS"
